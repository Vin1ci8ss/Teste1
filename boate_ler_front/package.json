{
  "name": "backend-tecboate",
  "version": "1.0.60",
  "description": "Backend para a aplicação TecBoate usando Node.js e MongoDB.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "build:exec": "pkg --targets node18-win-x64 --options no-warnings --output dist/tecboate-server.exe index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mongodb": "^6.3.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": "index.js",
    "assets": [
      "public/**/*" 
    ]
  }
}
